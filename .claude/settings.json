{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-edit.js\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run lint:ci)",
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(npm run docs)",
      "Bash(npx jest:*)",
      "Bash(npx tsc --noEmit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(npm publish:*)",
      "Bash(./release-and-publish.sh:*)"
    ]
  }
}
